# Copy to /etc/taozhiyy/ai-healthcheck.env on the UCloud server.
# Do not commit the real cookie.

TAOZIYY_AI_ENDPOINT=https://taozhiyy.top/api/chat
TAOZIYY_AI_MESSAGE=请回复 OK，并说明当前服务正常
TAOZIYY_AI_COOKIE=
TAOZIYY_AI_COUNT=20
TAOZIYY_AI_START=08:00
TAOZIYY_AI_END=23:30
TAOZIYY_AI_TIMEOUT=20
TAOZIYY_AI_LOG=/var/log/taozhiyy-ai-healthcheck.log
