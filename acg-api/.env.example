# Bangumi watching list (token is server-side only; never use a VITE_ variable)
BANGUMI_ACCESS_TOKEN=your_bangumi_personal_access_token
BANGUMI_API_BASE_URL=https://api.bgm.tv
BANGUMI_TIMEOUT_SECONDS=15

# Bilibili creator radar (legacy backend endpoint, optional overrides)
BILIBILI_UID=1061280173
BILIBILI_TIMEOUT_SECONDS=8
ACG_API_ADDR=127.0.0.1:8787
ACG_DATA_DIR=/var/lib/acg-api
ACG_ALLOWED_ORIGINS=https://taozhiyy.top,https://www.taozhiyy.top,http://localhost:5173,http://127.0.0.1:5173
SYNC_TRIGGER_TOKEN=replace_with_a_random_32_byte_token

# GitHub content publishing (server-side only)
OWNER_PUBLISH_GITHUB_OWNER=Yi-luo-hua
OWNER_PUBLISH_GITHUB_REPO=taozhiyy
OWNER_PUBLISH_GITHUB_BRANCH=master
OWNER_PUBLISH_GITHUB_TOKEN=your_fine_grained_github_token
# Dedicated bearer token used by the Claudian/Obsidian MCP bridge.
OBSIDIAN_PUBLISH_TOKEN=replace_with_a_different_random_32_byte_token

# Tencent Cloud COS upload/delete tools
# Keep real keys only in acg-api/.env or system environment variables. Never commit them.
# Preferred names for owner uploads.
TENCENT_COS_SECRET_ID=your_tencent_cos_secret_id
TENCENT_COS_SECRET_KEY=your_tencent_cos_secret_key
TENCENT_COS_REGION=ap-beijing
TENCENT_COS_BUCKET=tzyy-1330068502
TENCENT_COS_BASE_URL=https://tzyy-1330068502.cos.ap-beijing.myqcloud.com
# Legacy aliases are still accepted as fallbacks.
COS_SECRET_ID=your_tencent_cos_secret_id
COS_SECRET_KEY=your_tencent_cos_secret_key
COS_REGION=ap-beijing
COS_BUCKET=tzyy-1330068502
COS_PATH_PREFIX=AI自动化博客图片/

# Legal wallpaper pool providers (optional)
# If both are empty, the wallpaper pool sync is skipped and the frontend uses local gallery fallback.
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# DeepSeek — 博客小精灵（真实 Key 只放服务器 /opt/acg-api/.env，勿提交 Git）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Guestbook / friends-page email notifications
# Use an SMTP authorization code, not the mailbox login password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_sender_mailbox@example.com
SMTP_PASS=your_smtp_authorization_code
SMTP_FROM_NAME=Taozhiyy Notifications
MAIL_NOTIFY_TO=your_owner_notification_mailbox@example.com

# 邮箱登录（站长 173236231@qq.com 不可注册；登录后需学号二次验证 → 无限 AI）
AUTH_OWNER_PASSWORD=your_strong_password_min_8_chars
AUTH_OWNER_SECURITY_ANSWER=your_student_id_answer
AUTH_SESSION_DAYS=30
# 本地 HTTP 调试可设 false
# AUTH_COOKIE_SECURE=true
