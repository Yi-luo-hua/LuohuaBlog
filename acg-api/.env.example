# Bilibili tracker (optional overrides)
BILIBILI_UID=1061280173
ACG_API_ADDR=127.0.0.1:8787
ACG_DATA_DIR=/var/lib/acg-api

# DeepSeek — 博客小精灵（真实 Key 只放服务器 /opt/acg-api/.env，勿提交 Git）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 邮箱登录（站长 173236231@qq.com 不可注册；登录后需学号二次验证 → 无限 AI）
AUTH_OWNER_PASSWORD=your_strong_password_min_8_chars
AUTH_OWNER_SECURITY_ANSWER=your_student_id_answer
AUTH_SESSION_DAYS=30
# 本地 HTTP 调试可设 false
# AUTH_COOKIE_SECURE=true

# Tencent COS（用于 upload_cos.py 上传图片，服务器可选配置）
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_BUCKET=tzyy-1330068502
COS_REGION=ap-beijing
COS_PATH_PREFIX=AI自动化博客图片/
